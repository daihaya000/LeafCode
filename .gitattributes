# Default: normalize text files to LF in the repo. Without this, on Windows
# core.autocrlf=true makes git report CRLF working copies of LF blobs as
# modified (size-only phantom modifications) even when the diff is empty.
* text=auto

# cmd.exe needs CRLF: with LF-only line endings labels and goto break.
# Batch files must also stay ASCII-only (see docs/specs/bat-encoding-safety.md).
*.bat text eol=crlf
*.cmd text eol=crlf

# Future Windows scripts: keep CRLF so editors and archives do not ship LF-only.
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Japanese setup messages are printed with `type`, so keep them UTF-8 + CRLF.
scripts/setup-messages/*.txt text eol=crlf

# The committed launcher exe/icon are binaries produced by
# scripts/build-launcher.bat. git's content-based auto-detection already
# treats them as binary, but this makes it explicit so a contributor's
# core.autocrlf setting can never corrupt them on checkout.
*.exe binary
*.ico binary
