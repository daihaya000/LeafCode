{
  "provider": {
    "cursor": {
      "name": "Cursor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:32125/v1"
      },
      "models": {
        "auto": {
          "name": "Auto",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "cost": {
            "input": 1.25,
            "output": 6,
            "cache_read": 0.25,
            "cache_write": 1.25
          },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      },
      "whitelist": ["auto"]
    }
  }
}
