{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "name": "Anthropic",
      "npm": "@ai-sdk/anthropic",
      "whitelist": [
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-haiku-4-5"
      ],
      "models": {
        "claude-opus-5": {
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        },
        "claude-sonnet-5": {
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        },
        "claude-haiku-4-5": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    }
  }
}
