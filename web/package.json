{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:addons": "node scripts/sync-addon-assets.mjs",
    "predev": "npm run sync:addons",
    "prebuild": "npm run sync:addons && node ../scripts/production-webui-build-guard.mjs",
    "postbuild": "node scripts/verify-tsconfig.mjs",
    "prestart": "npm run sync:addons",
    "pretest": "npm run sync:addons",
    "pretypecheck": "npm run sync:addons",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ../docs/opencode/openapi.json -o src/lib/opencode-schema.d.ts",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:direct": "playwright test",
    "e2e:smoke": "node scripts/e2e.mjs --project=chromium smoke.spec.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
