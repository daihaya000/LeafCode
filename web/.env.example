# OpenCode engine (BFF → serve) — always localhost
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Host (OpenCodeWebUI.exe launcher / host/src/index.js)
# OPENCODE_WEBUI_HOST=127.0.0.1 # default: loopback only (not exposed to LAN/VPN)
# OPENCODE_WEBUI_HOST=0.0.0.0   # opt-in: reachable via VPN/LAN (phone) — use Caddy instead when possible
# OPENCODE_WEBUI_PORT=3000
