# Allow install scripts for native dependencies (npm >= 12 blocks them by
# default unless listed here). Without this, `npm ci` cannot build
# better-sqlite3 / esbuild / unrs-resolver and the app fails at runtime.
# `opencode-ai` mirrors the user-level allow-scripts entry so project scope
# does not drop it (project config overrides user config per key).
allow-scripts=opencode-ai,better-sqlite3,esbuild,unrs-resolver
