node_modules/
.next/
.next-*/
.env*.local
*.log
.DS_Store
Thumbs.db
desktop.ini

# PowerShell / CLI accident artifacts
/$null
/-p/
# Legacy worktree location (kept for backward compat; new worktrees live under
# the machine-local data dir, but old DB rows may still point here).
.webui-worktrees/

# User-specific Caddy config (seeded from deploy/Caddyfile.example)
deploy/Caddyfile
# Caddy runtime state
deploy/.caddy/

# Synced from repo-root addons/*/public (npm run sync:addons)
web/public/addons/

# Native launcher build output (scripts/build-launcher.bat regenerates these
# from scripts/launcher/Launcher.cs + host/src/icon.json; not shipped in git)
scripts/launcher/*.exe
scripts/launcher/*.ico
scripts/launcher/*.obj
scripts/launcher/*.pdb

web/playwright-report/
web/.playwright/

# OpenCode loop runtime state (per-session, machine-local)
.opencode/opencode-loop/

# cursor-acp materialized image attachments (for cursor-agent Read)
.opencode-cursor-attachments/

# OpenCode WebUI runtime state (per-session, machine-local)
.opencode-webui/

# Superpowers agent scratch state
.superpowers/

# Internal AI agent working notes / session logs (not part of the shipped
# program; excluded from public history on 2026-07-19). These files still
# exist locally for the agent's own workflow but must not be tracked again.
/MEMORY.md
/LESSONS.md
/architecture.md
/docs/improvement-plan.md
/docs/home-composer-redesign.md
/docs/agent-guidance/
/docs/superpowers/
/.cursor/rules/
/.claude/launch.json
