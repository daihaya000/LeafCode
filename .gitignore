# Any folder whose name starts with a dot is local/tool-scratch state;
# do not commit it (files like .gitignore / .editorconfig are unaffected).
.*/
# Except GitHub Actions workflows (tracked: encoding-check.yml, ci.yml).
!.github/

node_modules/
.next/
.next-*/
.env*.local
*.log
.DS_Store
Thumbs.db
desktop.ini

# PowerShell / CLI accident artifacts
/$null
/-p/
# Legacy worktree location (kept for backward compat; new worktrees live under
# the machine-local data dir, but old DB rows may still point here).
.webui-worktrees/

# User-specific Caddy config (seeded from deploy/Caddyfile.example)
deploy/Caddyfile
# Caddy runtime state
deploy/.caddy/

# Synced from repo-root addons/*/public (npm run sync:addons)
web/public/addons/

# Native launcher: the entry-point exe itself (OpenCodeWebUI.exe) is tracked
# at the repository root so a fresh clone can start without building anything.
# scripts/build-launcher.bat regenerates it from scripts/launcher/Launcher.cs
# + host/src/icon.json; only its transient build artifacts stay ignored.
OpenCodeWebUI.exe.old
scripts/launcher/*.exe
scripts/launcher/*.ico
scripts/launcher/*.obj
scripts/launcher/*.pdb

web/playwright-report/
web/.playwright/

# Browser Bridge local dependencies and transient captures
browser-bridge/node_modules/
browser-bridge/.screenshots/

# OpenCode loop runtime state (per-session, machine-local)
.opencode/opencode-loop/

# cursor-acp materialized image attachments (for cursor-agent Read)
.opencode-cursor-attachments/

# OpenCode WebUI runtime state (per-session, machine-local)
.opencode-webui/

# Superpowers agent scratch state
.superpowers/

# Internal AI agent working notes / session logs (not part of the shipped
# program; excluded from public history on 2026-07-19). These files still
# exist locally for the agent's own workflow but must not be tracked again.
/MEMORY.md
/LESSONS.md
/architecture.md
/docs/improvement-plan.md
/docs/home-composer-redesign.md
/docs/agent-guidance/
/docs/superpowers/
/.cursor/rules/
/.claude/launch.json
